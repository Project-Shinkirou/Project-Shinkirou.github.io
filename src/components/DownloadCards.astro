---
// Per-platform ShinkiEMU Manager downloads: the latest Manager release's
// packages for each platform, with build status from the build inventory.
// `compact` (home page) shows only the actions; the full view adds targets,
// sizes and checksums in a collapsed panel. The visitor's own platform is
// highlighted and moved first client-side.
import PlatformIcon from './PlatformIcon.astro';
import { formatBytes, formatUtc, STRINGS, type Locale } from '../lib/i18n.ts';
import { managerDownloads } from '../lib/platforms.ts';
import type { ManagerAsset } from '../lib/site-data.ts';
import { RELEASES_URL, site } from '../lib/site.ts';

interface Props {
  locale: Locale;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const strings = STRINGS[locale];
const t = strings.download;
const release = site.manager_release;
const buildDocs = `/${locale}/shinkiemu/docs/build-and-release/`;
const cards = managerDownloads(site.targets, release);
const assetTitle = (asset: ManagerAsset) =>
  asset.platform === 'android'
    ? strings.download.universal
    : [strings.architecture[asset.architecture], asset.variant ? strings.variant[asset.variant] : null].filter(Boolean).join(' · ');
---

<div class="release-line">
  {
    release ? (
      <p>
        <span class="release-version">
          ShinkiEMU Manager <strong>{release.version}</strong>
        </span>
        {release.prerelease && <span class="chip chip-warning">{t.prerelease}</span>}
        <span class="muted">
          {t.published}{' '}
          <time datetime={release.published_at}>{formatUtc(release.published_at, locale, false)}</time>
        </span>
        <a href={release.html_url}>{t.releaseNotes}</a>
      </p>
    ) : (
      <p>
        <strong>{t.notReleased}</strong>
        <span>{t.notReleasedBody}</span>
      </p>
    )
  }
  {!compact && <p class="release-note">{t.componentNote}</p>}
</div>

<ul class:list={['download-grid', { 'download-grid-compact': compact }]} data-download-grid>
  {
    cards.map((card) => (
      <li class:list={['download-card', `is-${card.state}`]} data-platform={card.platform}>
        <div class="download-head">
          <PlatformIcon platform={card.platform} size={28} class="download-icon" />
          <h3>{strings.platform[card.platform]}</h3>
          <span class="chip chip-current" data-current-badge hidden>
            {t.yourDevice}
          </span>
        </div>

        <p class="download-build-summary">
          {t.targetState(card.supported, card.targets.length)}
          {card.state === 'test' && (
            <>
              {' '}
              <span class="chip chip-warning">{t.testOnly}</span>
            </>
          )}
        </p>

        {card.assets.length > 0 ? (
          <ul class="asset-actions">
            {card.assets.map((asset) => {
              const title = assetTitle(asset);
              const detail = asset.variant ? `${title} ${t.testPackage}` : title;
              return (
                <li>
                  <a
                    class:list={['button', asset.variant ? 'button-secondary' : 'button-primary']}
                    href={asset.url}
                    aria-label={t.downloadLabel(strings.platform[card.platform], detail, release?.version ?? '')}
                  >
                    {t.download}
                  </a>
                  <span class="asset-meta">
                    {title}
                    {asset.variant && <span class="chip chip-warning">{t.testPackage}</span>}
                    <span class="muted">{formatBytes(asset.size, locale)}</span>
                  </span>
                </li>
              );
            })}
          </ul>
        ) : (
          <div class="download-empty">
            <p class="download-empty-title">{release ? t.noAsset(release.version) : t.notReleased}</p>
            <p class="download-empty-links">
              <a href={buildDocs}>{t.buildFromSource}</a>
              <a href={RELEASES_URL}>{t.releases}</a>
            </p>
          </div>
        )}

        {!compact && (card.targets.length > 0 || card.assets.length > 0) && (
          <details class="download-more">
            <summary>{t.details}</summary>
            {card.targets.length > 0 && (
              <>
                <p class="download-more-title">{t.buildStatus}</p>
                <ul class="target-list">
                  {card.targets.map((target) => (
                    <li>
                      <span>
                        {strings.architecture[target.architecture]} · {strings.variant[target.variant]}
                      </span>
                      <span class={`chip chip-${target.manager.status}`}>
                        {target.manager.status === 'supported' ? strings.platformState.supported : strings.platformState.blocked}
                      </span>
                      {target.manager.reason && <span class="target-reason">{target.manager.reason}</span>}
                    </li>
                  ))}
                </ul>
              </>
            )}
            {card.assets.map((asset) => (
              <dl class="facts facts-compact">
                <div class="facts-wide">
                  <dt>{t.version}</dt>
                  <dd>
                    {release?.version} · {assetTitle(asset)}
                  </dd>
                </div>
                <div class="facts-wide">
                  <dt>{t.sha256}</dt>
                  <dd>{asset.sha256 ? <code class="hash">{asset.sha256}</code> : <span class="muted">{t.noSha256}</span>}</dd>
                </div>
              </dl>
            ))}
          </details>
        )}
      </li>
    ))
  }
</ul>

<script>
  import { detectPlatform } from '../lib/detect-platform.ts';

  // Progressive enhancement: highlight the card for the visitor's platform
  // and move it to the front of its grid.
  const current = detectPlatform();
  if (current) {
    for (const grid of document.querySelectorAll<HTMLElement>('[data-download-grid]')) {
      const card = grid.querySelector<HTMLElement>(`.download-card[data-platform="${current}"]`);
      if (!card) continue;
      card.classList.add('is-current');
      grid.prepend(card);
      const badge = card.querySelector<HTMLElement>('[data-current-badge]');
      if (badge) badge.hidden = false;
    }
  }
</script>
