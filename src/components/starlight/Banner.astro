---
// Starlight Banner override: keeps per-page `banner` frontmatter and adds the
// synthetic-data warning shared with the product layout.
import Default from '@astrojs/starlight/components/Banner.astro';
import SyntheticBanner from '../SyntheticBanner.astro';
import { isLocale } from '../../lib/i18n.ts';

const { locale } = Astro.locals.starlightRoute;
---

<SyntheticBanner locale={isLocale(locale) ? locale : 'zh-cn'} />
<Default />
