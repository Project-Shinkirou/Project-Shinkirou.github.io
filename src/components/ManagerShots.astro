---
// Screenshots of the real Manager UI (Slint ManagerWindow, software renderer,
// self-authored demo data), in the page's language. Each shot ships a dark and
// a light picture; CSS shows the one matching the portal theme, and lazy
// loading skips the hidden one. Files: public/shots/<theme>/<id>-<lang>-{800,1600}.webp
// with an 800px PNG fallback, all 16:10.
import { LANG, STRINGS, type Locale } from '../lib/i18n.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = STRINGS[locale].shinkiemu;
const lang = LANG[locale];
const themes = ['dark', 'light'] as const;
const file = (theme: string, id: string, size: string, ext: string) => `/shots/${theme}/${id}-${lang}-${size}.${ext}`;
---

<ul class="grid grid-2 shot-grid">
  {
    t.shots.map((shot) => (
      <li class="card shot-card">
        <figure>
          {themes.map((theme) => (
            <a class:list={['shot-link', `shot-${theme}`]} href={file(theme, shot.id, '1600', 'webp')}>
              <picture>
                <source
                  type="image/webp"
                  srcset={`${file(theme, shot.id, '800', 'webp')} 800w, ${file(theme, shot.id, '1600', 'webp')} 1600w`}
                  sizes="(min-width: 76rem) 36rem, (min-width: 48rem) calc(50vw - 3rem), calc(100vw - 4rem)"
                />
                <img src={file(theme, shot.id, '800', 'png')} width="1600" height="1000" alt={shot.alt} loading="lazy" decoding="async" />
              </picture>
            </a>
          ))}
          <figcaption>
            <strong>{shot.title}</strong>
            <span>{shot.caption}</span>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>
