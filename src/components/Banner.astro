---
// Starlight Banner override: keeps per-page `banner` frontmatter and adds a
// permanent warning on every page of a build made from synthetic fixtures.
import Default from '@astrojs/starlight/components/Banner.astro';
import { STRINGS, type Locale } from '../lib/i18n.ts';
import { site } from '../lib/site.ts';

const locale = (Astro.locals.starlightRoute.locale ?? 'zh-cn') as Locale;
---

{
  site.synthetic && (
    <div class="synthetic-banner" role="note" data-pagefind-ignore>
      {STRINGS[locale].syntheticBanner}
    </div>
  )
}
<Default />
