---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import VndbTitle from '../../../components/VndbTitle.astro';
import { formatBytes, LANG, localizedText, LOCALES, STRINGS, type Locale } from '../../../lib/i18n.ts';
import { corePlatformStates, PLATFORM_ORDER } from '../../../lib/platforms.ts';
import type { Platform } from '../../../lib/site-data.ts';
import { PATCH_ISSUE_URL, site } from '../../../lib/site.ts';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const lang = LANG[locale];
const strings = STRINGS[locale];
const t = strings.patches;
const base = `/${locale}`;
const coreName: Record<string, string> = Object.fromEntries(site.matrix.map((core) => [core.plugin_id, core.core]));
const total = site.patches.length;

// Patch data has no platform field. A patch is usable where one of the cores it
// lists is available (buildable or embedded in the Manager) in the build matrix.
const corePlatforms = new Map(
  site.matrix.map((core) => [
    core.plugin_id,
    new Set(
      corePlatformStates(core, site.targets)
        .filter((item) => item.state === 'supported' || item.state === 'static')
        .map((item) => item.platform),
    ),
  ]),
);

const searchText = (parts: (string | null | undefined)[]) =>
  parts.filter(Boolean).join('\n').normalize('NFKC').toLowerCase();
const workTitle = (id: string) => site.titles.vn[id].title;
const releaseAnchor = (id: string) => `release-${id}`;

// One card per release. patches-v2 validation guarantees that a release shared
// by several patches carries the same description in each of them.
const releaseCards = new Map<
  string,
  { release: (typeof site.patches)[number]['releases'][number]; patchIds: string[] }
>();
for (const patch of site.patches) {
  for (const release of patch.releases) {
    const card = releaseCards.get(release.release_id);
    if (card) card.patchIds.push(patch.id);
    else releaseCards.set(release.release_id, { release, patchIds: [patch.id] });
  }
}

// Title and summary in the page language when the entry has it, otherwise the
// next language in the locale's fallback order (ja → en → zh-CN).
const patches = site.patches
  .map((patch) => ({
    ...patch,
    platforms: PLATFORM_ORDER.filter((platform) => patch.emulators.some((id) => corePlatforms.get(id)?.has(platform))),
    shownTitle: localizedText(patch.title, locale),
    shownSummary: localizedText(patch.summary, locale),
    search: searchText([
      patch.id,
      patch.title['zh-CN'],
      patch.title.en,
      patch.title.ja,
      patch.summary['zh-CN'],
      patch.summary.en,
      patch.summary.ja,
      patch.version,
      patch.recipe?.script,
      ...patch.vn_ids.flatMap((id) => [id, site.titles.vn[id].title, site.titles.vn[id].alttitle]),
      ...patch.releases.flatMap((release) => [
        release.release_id,
        release.title['zh-CN'],
        release.title.en,
        release.title.ja,
        release.edition,
        release.game_version,
        site.titles.release[release.release_id].title,
        site.titles.release[release.release_id].alttitle,
      ]),
      ...patch.emulators.flatMap((id) => [id, coreName[id]]),
    ]),
  }))
  .sort((a, b) => a.shownTitle.text.localeCompare(b.shownTitle.text, lang) || a.id.localeCompare(b.id));
const patchById = new Map(patches.map((patch) => [patch.id, patch]));

const works = [...new Set(patches.flatMap((patch) => patch.vn_ids))].sort(
  (a, b) => workTitle(a).localeCompare(workTitle(b), 'en') || a.localeCompare(b, 'en', { numeric: true }),
);
// Release cards and release options follow the work order, then the release id.
const releases = [...releaseCards.values()].sort(
  (a, b) =>
    works.indexOf(a.release.vn_id) - works.indexOf(b.release.vn_id) ||
    a.release.release_id.localeCompare(b.release.release_id, 'en', { numeric: true }),
);
const countWhere = (test: (patch: (typeof patches)[number]) => boolean) => patches.filter(test).length;
const withCount = (label: string, n: number) => `${label} (${n})`;

// Only values that occur in the data are offered; every option matches at least
// one patch. Release options carry their work so the client can narrow them.
const filters = [
  {
    name: 'work',
    label: t.work,
    options: works.map((id) => ({
      value: id,
      work: undefined as string | undefined,
      label: withCount(`${workTitle(id)} · ${id}`, countWhere((patch) => patch.vn_ids.includes(id))),
    })),
  },
  {
    name: 'release',
    label: t.release,
    options: releases.map(({ release, patchIds }) => ({
      value: release.release_id,
      work: release.vn_id as string | undefined,
      label: withCount(
        [localizedText(release.title, locale).text, release.edition, release.game_version, release.release_id]
          .filter(Boolean)
          .join(' · '),
        patchIds.length,
      ),
    })),
  },
  {
    name: 'core',
    label: t.core,
    options: site.matrix
      .map((core) => ({ core, n: countWhere((patch) => patch.emulators.includes(core.plugin_id)) }))
      .filter((item) => item.n > 0)
      .map((item) => ({ value: item.core.plugin_id, work: undefined, label: withCount(item.core.core, item.n) })),
  },
  {
    name: 'platform',
    label: t.platform,
    options: PLATFORM_ORDER.map((platform: Platform) => ({ platform, n: countWhere((patch) => patch.platforms.includes(platform)) }))
      .filter((item) => item.n > 0)
      .map((item) => ({ value: item.platform, work: undefined, label: withCount(strings.platform[item.platform], item.n) })),
  },
].filter((filter) => filter.options.length > 0);
const shownText = (shown: number) => t.shown.replace('{shown}', String(shown)).replace('{total}', String(total));
const otherLang = (value: 'zh-CN' | 'en' | 'ja') => (value === lang ? undefined : value);
---

<ProductLayout locale={locale} title={t.title} description={t.description} current="patches">
  <div class="container page-head">
    <p class="breadcrumb"><a href={`${base}/shinkiemu/`}>ShinkiEMU</a></p>
    <h1>{t.title}</h1>
    <p class="lead">{t.lead}</p>
    <div class="actions">
      <a class="button button-primary" href={PATCH_ISSUE_URL}>{t.submit}</a>
    </div>
  </div>

  <div class="container patch-intro">
    <section class="card patch-intro-card" aria-labelledby="patch-usage-title">
      <h2 id="patch-usage-title">{t.usageTitle}</h2>
      <ul class="patch-intro-list">
        <li>{t.usageOnline}</li>
        <li>{t.usageLocal}</li>
      </ul>
    </section>
    <section class="card patch-intro-card" aria-labelledby="patch-submit-title">
      <h2 id="patch-submit-title">{t.submitTitle}</h2>
      <p>{t.submitLead}</p>
      <ul class="patch-intro-list">
        {t.submitItems.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p class="patch-note">{t.submitNote}</p>
      <p>
        <a class="button button-secondary" href={PATCH_ISSUE_URL}>
          {t.submit}
        </a>
      </p>
    </section>
  </div>

  <div class="container patch-page">
    {
      total === 0 ? (
        <p class="no-match">{t.empty}</p>
      ) : (
        <patch-filter data-shown={t.shown} data-total={total}>
          {/* Shown by the filter script; without JavaScript every patch stays listed. */}
          <form class="card filter-panel" role="search" aria-label={t.filters} data-filter-form hidden>
            <div class="filter-fields">
              <label class="field field-search">
                <span>{t.search}</span>
                <input type="search" name="q" placeholder={t.searchPlaceholder} autocomplete="off" spellcheck="false" />
              </label>
              {filters.map((filter) => (
                <label class="field">
                  <span>{filter.label}</span>
                  <select name={filter.name}>
                    <option value="">{t.all}</option>
                    {filter.options.map((option) => (
                      <option value={option.value} data-work={option.work}>
                        {option.label}
                      </option>
                    ))}
                  </select>
                </label>
              ))}
            </div>
            <div class="filter-row">
              <p class="patch-note">{t.platformNote}</p>
              <button type="reset" class="button button-secondary">
                {t.reset}
              </button>
            </div>
          </form>

          <p class="filter-count" aria-live="polite" data-count-output>
            {shownText(total)}
          </p>

          <section class="patch-list" aria-labelledby="patch-list-title">
            <h2 id="patch-list-title" class="sr-only">
              {t.listLabel}
            </h2>
            <div class="patch-list-head" aria-hidden="true">
              <span>{t.columns.patch}</span>
              <span>{t.columns.releases}</span>
              <span>{t.columns.core}</span>
              <span>{t.columns.platforms}</span>
              <span>{t.columns.version}</span>
            </div>
            <ul class="patch-rows">
              {patches.map((patch) => (
                <li
                  class="patch-row"
                  id={`patch-${patch.id}`}
                  data-search={patch.search}
                  data-work={patch.vn_ids.join(' ')}
                  data-release={patch.releases.map((release) => release.release_id).join(' ')}
                  data-core={patch.emulators.join(' ')}
                  data-platform={patch.platforms.join(' ')}
                >
                  <div class="patch-cell patch-name">
                    <h3 lang={otherLang(patch.shownTitle.lang)}>{patch.shownTitle.text}</h3>
                    <code class="patch-id">{patch.id}</code>
                  </div>
                  <div class="patch-cell">
                    <span class="patch-label">{t.columns.releases}</span>
                    <ul class="patch-values">
                      {patch.vn_ids.map((id) => {
                        const bound = patch.releases.filter((release) => release.vn_id === id);
                        return (
                          <li>
                            <VndbTitle id={id} kind="vn" />
                            {bound.length === 0 ? (
                              <span class="cell-sub">{t.unbound}</span>
                            ) : (
                              <ul class="patch-release-links">
                                {bound.map((release) => {
                                  const title = localizedText(release.title, locale);
                                  return (
                                    <li>
                                      <a href={`#${releaseAnchor(release.release_id)}`} lang={otherLang(title.lang)}>
                                        {title.text}
                                      </a>
                                      <span class="cell-sub">
                                        {[release.edition, release.game_version, release.release_id].filter(Boolean).join(' · ')}
                                      </span>
                                    </li>
                                  );
                                })}
                              </ul>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                  <div class="patch-cell">
                    <span class="patch-label">{t.columns.core}</span>
                    <ul class="patch-values">
                      {patch.emulators.map((id) => (
                        <li>
                          {coreName[id]}
                          <code class="cell-sub patch-id">{id}</code>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="patch-cell">
                    <span class="patch-label">{t.columns.platforms}</span>
                    {patch.platforms.length === 0 ? (
                      <span class="muted">{t.noPlatform}</span>
                    ) : (
                      <ul class="patch-platforms">
                        {patch.platforms.map((platform) => (
                          <li>{strings.platform[platform]}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                  <div class="patch-cell">
                    <span class="patch-label">{t.columns.version}</span>
                    <span class="patch-version">{patch.version}</span>
                  </div>
                  <details class="patch-details">
                    <summary aria-label={t.detailsLabel(patch.shownTitle.text)}>{t.details}</summary>
                    <div class="patch-details-body">
                      <p class="patch-summary" lang={otherLang(patch.shownSummary.lang)}>
                        {patch.shownSummary.text}
                      </p>
                      <dl class="facts">
                        <div>
                          <dt>{t.license}</dt>
                          <dd>{patch.license}</dd>
                        </div>
                        {patch.recipe && (
                          <div>
                            <dt>{t.script}</dt>
                            <dd>
                              <code>{patch.recipe.script}</code>
                            </dd>
                          </div>
                        )}
                        {patch.source_url && (
                          <div class="facts-wide">
                            <dt>{t.source}</dt>
                            <dd>
                              <a href={patch.source_url}>{patch.source_url}</a>
                            </dd>
                          </div>
                        )}
                        <div class="facts-wide">
                          <dt>{t.authorization}</dt>
                          <dd>
                            {patch.authorization_url ? (
                              <a href={patch.authorization_url}>{patch.authorization_url}</a>
                            ) : (
                              <span class="muted">{t.noAuthorization}</span>
                            )}
                          </dd>
                        </div>
                        {patch.issue_url && (
                          <div class="facts-wide">
                            <dt>{t.issue}</dt>
                            <dd>
                              <a href={patch.issue_url}>{patch.issue_url}</a>
                            </dd>
                          </div>
                        )}
                      </dl>
                      <p class="cell-sub">{t.recipeNote}</p>
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          </section>
          <p class="no-match" role="status" data-no-match hidden>
            {t.noMatch}
          </p>
        </patch-filter>
      )
    }
  </div>

  {
    total > 0 && (
      <section class="section container release-section" aria-labelledby="releases-title">
        <h2 id="releases-title">{t.releasesTitle}</h2>
        {releases.length === 0 ? (
          <p class="muted">{t.noReleases}</p>
        ) : (
          <>
            <p class="patch-note">{t.releasesLead}</p>
            <div class="grid grid-2 release-grid">
              {releases.map(({ release, patchIds }) => {
                const title = localizedText(release.title, locale);
                const vndb = site.titles.release[release.release_id];
                return (
                  <article
                    class="card release-card"
                    id={releaseAnchor(release.release_id)}
                    aria-labelledby={`${releaseAnchor(release.release_id)}-title`}
                  >
                    <header class="release-card-head">
                      <h3 id={`${releaseAnchor(release.release_id)}-title`} lang={otherLang(title.lang)}>
                        {title.text}
                      </h3>
                      <span class="chip">{release.edition}</span>
                    </header>
                    <p class="release-vndb">
                      <span class="vndb-title">{vndb.title}</span>
                      {vndb.alttitle && <span class="vndb-alt">{vndb.alttitle}</span>}
                      <a href={`https://vndb.org/${release.release_id}`} aria-label={t.vndbLink(release.release_id)}>
                        {release.release_id}
                      </a>
                    </p>
                    <dl class="facts facts-compact">
                      <div>
                        <dt>{t.work}</dt>
                        <dd>
                          <VndbTitle id={release.vn_id} kind="vn" />
                        </dd>
                      </div>
                      <div>
                        <dt>{t.gameVersion}</dt>
                        <dd>{release.game_version ?? <span class="muted">{t.noGameVersion}</span>}</dd>
                      </div>
                      <div class="facts-wide">
                        <dt>{t.patchesFor}</dt>
                        <dd>
                          <ul class="release-patches">
                            {patchIds.map((id) => {
                              const patch = patchById.get(id)!;
                              return (
                                <li>
                                  <a href={`#patch-${id}`} lang={otherLang(patch.shownTitle.lang)}>
                                    {patch.shownTitle.text}
                                  </a>
                                  <span class="patch-version">{patch.version}</span>
                                </li>
                              );
                            })}
                          </ul>
                        </dd>
                      </div>
                    </dl>
                    <details class="release-files">
                      <summary>{t.fingerprints(release.fingerprints.length)}</summary>
                      <ul class="fingerprint-list">
                        {release.fingerprints.map((file) => (
                          <li>
                            <code class="fingerprint-path">{file.path}</code>
                            <span class="cell-sub">
                              {t.size} {formatBytes(file.size, locale)}
                            </span>
                            <span class="cell-sub">
                              {t.sha256} <code class="hash">{file.sha256}</code>
                            </span>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </article>
                );
              })}
            </div>
          </>
        )}
      </section>
    )
  }
</ProductLayout>

<script>
  // Client-side search and filtering, mirrored in the URL query so a filtered
  // view can be linked. Without JavaScript the form stays hidden and every
  // patch stays listed.
  const SELECTS = ['work', 'release', 'core', 'platform'] as const;
  type Select = (typeof SELECTS)[number];

  const normalize = (value: string) => value.normalize('NFKC').toLowerCase().trim();

  class PatchFilter extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector<HTMLFormElement>('[data-filter-form]');
      if (!form) return;
      const rows = [...this.querySelectorAll<HTMLElement>('.patch-row')];
      const count = this.querySelector<HTMLElement>('[data-count-output]');
      const noMatch = this.querySelector<HTMLElement>('[data-no-match]');
      const list = this.querySelector<HTMLElement>('.patch-list');
      const template = (this.dataset.shown ?? '').replace('{total}', this.dataset.total ?? '');
      const search = form.elements.namedItem('q') as HTMLInputElement;
      // A filter with no options in the data is not rendered.
      const selects = Object.fromEntries(
        SELECTS.flatMap((name) => {
          const select = form.elements.namedItem(name);
          return select instanceof HTMLSelectElement ? [[name, select]] : [];
        }),
      ) as Partial<Record<Select, HTMLSelectElement>>;
      const active = SELECTS.filter((name) => selects[name]);
      const valueOf = (name: Select) => selects[name]?.value ?? '';

      // The release list only offers releases of the chosen work; a release
      // of another work is cleared when the work changes.
      const narrowReleases = () => {
        const release = selects.release;
        if (!release) return;
        const work = valueOf('work');
        for (const option of release.options) {
          if (option.value === '') continue;
          const hidden = work !== '' && option.dataset.work !== work;
          option.hidden = hidden;
          option.disabled = hidden;
        }
        if (release.selectedOptions[0]?.disabled) release.value = '';
      };

      // Unknown values (stale links) fall back to "all" instead of hiding everything.
      const params = new URLSearchParams(window.location.search);
      search.value = params.get('q') ?? '';
      for (const name of active) {
        const select = selects[name]!;
        const wanted = params.get(name) ?? '';
        select.value = [...select.options].some((option) => option.value === wanted) ? wanted : '';
      }
      // A shared release link without its work still selects the release's work.
      if (selects.release && selects.work && valueOf('work') === '' && valueOf('release') !== '') {
        selects.work.value = selects.release.selectedOptions[0]?.dataset.work ?? '';
      }
      narrowReleases();

      const apply = (updateUrl: boolean) => {
        // Every whitespace-separated term must match somewhere in the row.
        const terms = normalize(search.value).split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const row of rows) {
          const haystack = row.dataset.search ?? '';
          const visible =
            terms.every((term) => haystack.includes(term)) &&
            active.every((name) => {
              const value = valueOf(name);
              return value === '' || (row.dataset[name] ?? '').split(' ').includes(value);
            });
          row.hidden = !visible;
          if (visible) shown += 1;
        }
        if (count) count.textContent = template.replace('{shown}', String(shown));
        if (noMatch) noMatch.hidden = shown !== 0;
        if (list) list.hidden = shown === 0;
        if (!updateUrl) return;
        const next = new URLSearchParams();
        const query = search.value.trim();
        if (query !== '') next.set('q', query);
        for (const name of active) if (valueOf(name) !== '') next.set(name, valueOf(name));
        const suffix = next.toString();
        history.replaceState(null, '', `${window.location.pathname}${suffix ? `?${suffix}` : ''}${window.location.hash}`);
      };

      // A link to one patch (#patch-<id>) opens its details.
      const openTarget = () => {
        const target = window.location.hash.startsWith('#patch-')
          ? document.getElementById(decodeURIComponent(window.location.hash.slice(1)))
          : null;
        const details = target?.querySelector('details');
        if (details) details.open = true;
      };

      form.addEventListener('input', (event) => {
        if (event.target === selects.work) narrowReleases();
        apply(true);
      });
      form.addEventListener('submit', (event) => event.preventDefault());
      // `reset` fires before the controls are cleared.
      form.addEventListener('reset', () =>
        setTimeout(() => {
          narrowReleases();
          apply(true);
        }),
      );
      window.addEventListener('hashchange', openTarget);

      form.hidden = false;
      apply(false);
      openTarget();
    }
  }
  customElements.define('patch-filter', PatchFilter);
</script>
