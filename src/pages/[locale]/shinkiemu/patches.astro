---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import VndbTitle from '../../../components/VndbTitle.astro';
import { formatBytes, LANG, localizedText, LOCALES, STRINGS, type Locale } from '../../../lib/i18n.ts';
import { corePlatformStates, PLATFORM_ORDER } from '../../../lib/platforms.ts';
import { PATCH_KINDS, type Platform } from '../../../lib/site-data.ts';
import { ISSUES_URL, site } from '../../../lib/site.ts';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const lang = LANG[locale];
const strings = STRINGS[locale];
const t = strings.patches;
const base = `/${locale}`;
const coreName: Record<string, string> = Object.fromEntries(site.matrix.map((core) => [core.plugin_id, core.core]));
const total = site.patches.length;

// patches.v1 has no platform field. A patch is usable where one of the cores it
// lists is available (buildable or embedded in the Manager) in the build matrix.
const corePlatforms = new Map(
  site.matrix.map((core) => [
    core.plugin_id,
    new Set(
      corePlatformStates(core, site.targets)
        .filter((item) => item.state === 'supported' || item.state === 'static')
        .map((item) => item.platform),
    ),
  ]),
);
const platformsOf = (emulators: readonly string[]): Platform[] =>
  PLATFORM_ORDER.filter((platform) => emulators.some((id) => corePlatforms.get(id)?.has(platform)));

const searchText = (parts: (string | null | undefined)[]) =>
  parts.filter(Boolean).join('\n').normalize('NFKC').toLowerCase();

// Title and summary in the page language when the entry has it, otherwise the
// next language in the locale's fallback order (ja → en → zh-CN).
const patches = site.patches
  .map((patch) => {
    const platforms = platformsOf(patch.emulators);
    return {
      ...patch,
      platforms,
      shownTitle: localizedText(patch.title, locale),
      shownSummary: localizedText(patch.summary, locale),
      search: searchText([
        patch.id,
        patch.title['zh-CN'],
        patch.title.en,
        patch.title.ja,
        patch.summary['zh-CN'],
        patch.summary.en,
        patch.summary.ja,
        patch.version,
        patch.recipe?.script,
        patch.artifact?.file_name,
        t.kinds[patch.kind],
        ...patch.vn_ids.flatMap((id) => [id, site.titles.vn[id].title, site.titles.vn[id].alttitle]),
        ...patch.release_ids.flatMap((id) => [id, site.titles.release[id].title, site.titles.release[id].alttitle]),
        ...patch.emulators.flatMap((id) => [id, coreName[id]]),
      ]),
    };
  })
  .sort((a, b) => a.shownTitle.text.localeCompare(b.shownTitle.text, lang) || a.id.localeCompare(b.id));

const workTitle = (id: string) => site.titles.vn[id].title;
const works = [...new Set(patches.flatMap((patch) => patch.vn_ids))].sort(
  (a, b) => workTitle(a).localeCompare(workTitle(b), 'en') || a.localeCompare(b, 'en', { numeric: true }),
);
const countWhere = (test: (patch: (typeof patches)[number]) => boolean) => patches.filter(test).length;
const withCount = (label: string, n: number) => `${label} (${n})`;

// Only values that occur in the data are offered; every option matches at least one patch.
const filters = [
  {
    name: 'work',
    label: t.work,
    options: works.map((id) => ({
      value: id,
      label: withCount(`${workTitle(id)} · ${id}`, countWhere((patch) => patch.vn_ids.includes(id))),
    })),
  },
  {
    name: 'core',
    label: t.core,
    options: site.matrix
      .map((core) => ({ core, n: countWhere((patch) => patch.emulators.includes(core.plugin_id)) }))
      .filter((item) => item.n > 0)
      .map((item) => ({ value: item.core.plugin_id, label: withCount(item.core.core, item.n) })),
  },
  {
    name: 'platform',
    label: t.platform,
    options: PLATFORM_ORDER.map((platform) => ({ platform, n: countWhere((patch) => patch.platforms.includes(platform)) }))
      .filter((item) => item.n > 0)
      .map((item) => ({ value: item.platform, label: withCount(strings.platform[item.platform], item.n) })),
  },
  {
    name: 'kind',
    label: t.kind,
    options: PATCH_KINDS.map((kind) => ({ kind, n: countWhere((patch) => patch.kind === kind) }))
      .filter((item) => item.n > 0)
      .map((item) => ({ value: item.kind, label: withCount(t.kindTitles[item.kind], item.n) })),
  },
];
const shownText = (shown: number) => t.shown.replace('{shown}', String(shown)).replace('{total}', String(total));
const otherLang = (value: 'zh-CN' | 'en' | 'ja') => (value === lang ? undefined : value);
---

<ProductLayout locale={locale} title={t.title} description={t.description} current="patches">
  <div class="container page-head">
    <p class="breadcrumb"><a href={`${base}/shinkiemu/`}>ShinkiEMU</a></p>
    <h1>{t.title}</h1>
    <p class="lead">{t.lead}</p>
    <div class="actions">
      <a class="button button-primary" href={`${ISSUES_URL}/new/choose`}>{t.submit}</a>
    </div>
  </div>

  <div class="container patch-page">
    {
      total === 0 ? (
        <p class="no-match">{t.empty}</p>
      ) : (
        <patch-filter data-shown={t.shown} data-total={total}>
          {/* Shown by the filter script; without JavaScript every patch stays listed. */}
          <form class="card filter-panel" role="search" aria-label={t.filters} data-filter-form hidden>
            <div class="filter-fields">
              <label class="field field-search">
                <span>{t.search}</span>
                <input type="search" name="q" placeholder={t.searchPlaceholder} autocomplete="off" spellcheck="false" />
              </label>
              {filters.map((filter) => (
                <label class="field">
                  <span>{filter.label}</span>
                  <select name={filter.name}>
                    <option value="">{t.all}</option>
                    {filter.options.map((option) => (
                      <option value={option.value}>{option.label}</option>
                    ))}
                  </select>
                </label>
              ))}
            </div>
            <div class="filter-row">
              <p class="patch-note">{t.platformNote}</p>
              <button type="reset" class="button button-secondary">
                {t.reset}
              </button>
            </div>
          </form>

          <p class="filter-count" aria-live="polite" data-count-output>
            {shownText(total)}
          </p>

          <section class="patch-list" aria-labelledby="patch-list-title">
            <h2 id="patch-list-title" class="sr-only">
              {t.listLabel}
            </h2>
            <div class="patch-list-head" aria-hidden="true">
              <span>{t.columns.patch}</span>
              <span>{t.columns.work}</span>
              <span>{t.columns.core}</span>
              <span>{t.columns.platforms}</span>
              <span>{t.columns.version}</span>
            </div>
            <ul class="patch-rows">
              {patches.map((patch) => (
                <li
                  class="patch-row"
                  id={`patch-${patch.id}`}
                  data-search={patch.search}
                  data-work={patch.vn_ids.join(' ')}
                  data-core={patch.emulators.join(' ')}
                  data-platform={patch.platforms.join(' ')}
                  data-kind={patch.kind}
                >
                  <div class="patch-cell patch-name">
                    <h3 lang={otherLang(patch.shownTitle.lang)}>{patch.shownTitle.text}</h3>
                    <span class="patch-tags">
                      <span class={`chip chip-kind-${patch.kind}`}>{t.kinds[patch.kind]}</span>
                      <code class="patch-id">{patch.id}</code>
                    </span>
                  </div>
                  <div class="patch-cell">
                    <span class="patch-label">{t.columns.work}</span>
                    <ul class="patch-values">
                      {patch.vn_ids.map((id) => (
                        <li>
                          <VndbTitle id={id} kind="vn" />
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="patch-cell">
                    <span class="patch-label">{t.columns.core}</span>
                    <ul class="patch-values">
                      {patch.emulators.map((id) => (
                        <li>
                          {coreName[id]}
                          <code class="cell-sub patch-id">{id}</code>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="patch-cell">
                    <span class="patch-label">{t.columns.platforms}</span>
                    {patch.platforms.length === 0 ? (
                      <span class="muted">{t.noPlatform}</span>
                    ) : (
                      <ul class="patch-platforms">
                        {patch.platforms.map((platform) => (
                          <li>{strings.platform[platform]}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                  <div class="patch-cell">
                    <span class="patch-label">{t.columns.version}</span>
                    <span class="patch-version">{patch.version}</span>
                  </div>
                  <details class="patch-details">
                    <summary aria-label={t.detailsLabel(patch.shownTitle.text)}>{t.details}</summary>
                    <div class="patch-details-body">
                      <p class="patch-summary" lang={otherLang(patch.shownSummary.lang)}>
                        {patch.shownSummary.text}
                      </p>
                      <dl class="facts">
                        <div class="facts-wide">
                          <dt>{t.releases}</dt>
                          <dd>
                            {patch.release_ids.length === 0 ? (
                              <span class="chip chip-warning chip-wrap">{t.releasesUnrestricted}</span>
                            ) : (
                              <ul class="work-list">
                                {patch.release_ids.map((id) => (
                                  <li>
                                    <VndbTitle id={id} kind="release" />
                                  </li>
                                ))}
                              </ul>
                            )}
                          </dd>
                        </div>
                        <div>
                          <dt>{t.license}</dt>
                          <dd>{patch.license}</dd>
                        </div>
                        {patch.recipe && (
                          <div>
                            <dt>{t.script}</dt>
                            <dd>
                              <code>{patch.recipe.script}</code>
                            </dd>
                          </div>
                        )}
                        {patch.source_url && (
                          <div class="facts-wide">
                            <dt>{t.source}</dt>
                            <dd>
                              <a href={patch.source_url}>{patch.source_url}</a>
                            </dd>
                          </div>
                        )}
                        <div class="facts-wide">
                          <dt>{t.authorization}</dt>
                          <dd>
                            {patch.authorization_url ? (
                              <a href={patch.authorization_url}>{patch.authorization_url}</a>
                            ) : (
                              <span class="muted">{t.noAuthorization}</span>
                            )}
                          </dd>
                        </div>
                        {patch.issue_url && (
                          <div class="facts-wide">
                            <dt>{t.issue}</dt>
                            <dd>
                              <a href={patch.issue_url}>{patch.issue_url}</a>
                            </dd>
                          </div>
                        )}
                        {patch.artifact && (
                          <>
                            <div class="facts-wide">
                              <dt>{t.artifact}</dt>
                              <dd>
                                <code>{patch.artifact.file_name}</code> · {formatBytes(patch.artifact.size, locale)}
                              </dd>
                            </div>
                            <div class="facts-wide">
                              <dt>{t.sha256}</dt>
                              <dd>
                                <code class="hash">{patch.artifact.sha256}</code>
                              </dd>
                            </div>
                          </>
                        )}
                      </dl>
                      {patch.recipe && <p class="cell-sub">{t.recipeNote}</p>}
                      {patch.kind === 'hosted' && patch.artifact && (
                        <p>
                          <a class="button button-primary" href={patch.artifact.url} aria-label={t.downloadLabel(patch.artifact.file_name)}>
                            {t.download}
                          </a>
                        </p>
                      )}
                      {patch.kind === 'external' && patch.artifact && (
                        <p>
                          <a href={patch.artifact.url} rel="nofollow noopener">
                            {t.externalArtifact}
                          </a>
                        </p>
                      )}
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          </section>
          <p class="no-match" role="status" data-no-match hidden>
            {t.noMatch}
          </p>
        </patch-filter>
      )
    }
  </div>
</ProductLayout>

<script>
  // Client-side search and filtering, mirrored in the URL query so a filtered
  // view can be linked. Without JavaScript the form stays hidden and every
  // patch stays listed.
  const SELECTS = ['work', 'core', 'platform', 'kind'] as const;
  type Select = (typeof SELECTS)[number];

  const normalize = (value: string) => value.normalize('NFKC').toLowerCase().trim();

  class PatchFilter extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector<HTMLFormElement>('[data-filter-form]');
      if (!form) return;
      const rows = [...this.querySelectorAll<HTMLElement>('.patch-row')];
      const count = this.querySelector<HTMLElement>('[data-count-output]');
      const noMatch = this.querySelector<HTMLElement>('[data-no-match]');
      const list = this.querySelector<HTMLElement>('.patch-list');
      const template = (this.dataset.shown ?? '').replace('{total}', this.dataset.total ?? '');
      const search = form.elements.namedItem('q') as HTMLInputElement;
      const selects = Object.fromEntries(
        SELECTS.map((name) => [name, form.elements.namedItem(name) as HTMLSelectElement]),
      ) as Record<Select, HTMLSelectElement>;

      // Unknown values (stale links) fall back to "all" instead of hiding everything.
      const params = new URLSearchParams(window.location.search);
      search.value = params.get('q') ?? '';
      for (const name of SELECTS) {
        const wanted = params.get(name) ?? '';
        selects[name].value = [...selects[name].options].some((option) => option.value === wanted) ? wanted : '';
      }

      const apply = (updateUrl: boolean) => {
        // Every whitespace-separated term must match somewhere in the row.
        const terms = normalize(search.value).split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const row of rows) {
          const haystack = row.dataset.search ?? '';
          const visible =
            terms.every((term) => haystack.includes(term)) &&
            SELECTS.every((name) => {
              const value = selects[name].value;
              return value === '' || (row.dataset[name] ?? '').split(' ').includes(value);
            });
          row.hidden = !visible;
          if (visible) shown += 1;
        }
        if (count) count.textContent = template.replace('{shown}', String(shown));
        if (noMatch) noMatch.hidden = shown !== 0;
        if (list) list.hidden = shown === 0;
        if (!updateUrl) return;
        const next = new URLSearchParams();
        const query = search.value.trim();
        if (query !== '') next.set('q', query);
        for (const name of SELECTS) if (selects[name].value !== '') next.set(name, selects[name].value);
        const suffix = next.toString();
        history.replaceState(null, '', `${window.location.pathname}${suffix ? `?${suffix}` : ''}${window.location.hash}`);
      };

      // A link to one patch (#patch-<id>) opens its details.
      const openTarget = () => {
        const target = window.location.hash.startsWith('#patch-')
          ? document.getElementById(decodeURIComponent(window.location.hash.slice(1)))
          : null;
        const details = target?.querySelector('details');
        if (details) details.open = true;
      };

      form.addEventListener('input', () => apply(true));
      form.addEventListener('submit', (event) => event.preventDefault());
      // `reset` fires before the controls are cleared.
      form.addEventListener('reset', () => setTimeout(() => apply(true)));
      window.addEventListener('hashchange', openTarget);

      form.hidden = false;
      apply(false);
      openTarget();
    }
  }
  customElements.define('patch-filter', PatchFilter);
</script>
