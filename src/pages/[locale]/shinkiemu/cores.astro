---
import PlatformStates from '../../../components/PlatformStates.astro';
import StateLegend from '../../../components/StateLegend.astro';
import ProductLayout from '../../../layouts/ProductLayout.astro';
import { formatBytes, LOCALES, STRINGS, type Locale } from '../../../lib/i18n.ts';
import { coreAnchor, corePlatformStates } from '../../../lib/platforms.ts';
import { coreReleaseLabel, latestCoreRelease, sortCoreReleases } from '../../../lib/site-data.ts';
import { site } from '../../../lib/site.ts';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = STRINGS[locale].cores;
const base = `/${locale}`;

const cores = site.matrix.map((core) => {
  const releases = sortCoreReleases(site.cores.filter((release) => release.plugin_id === core.plugin_id));
  return {
    ...core,
    anchor: coreAnchor(core.plugin_id),
    states: corePlatformStates(core, site.targets),
    supported: core.targets.filter((target) => target.status !== 'blocked').length,
    shortRevision: core.revision.slice(0, 12),
    repoName: core.repo.replace('https://github.com/', ''),
    upstreamName: core.upstream?.replace('https://github.com/', '') ?? null,
    upstreamIdentityName: core.identity?.upstream.repo.replace('https://github.com/', '') ?? null,
    upstreamCommitShort: core.identity?.upstream.commit.slice(0, 12) ?? null,
    // Same original engine, different implementation (e.g. Musica and ReMinori).
    siblings: site.matrix.filter((other) => other.family === core.family && other.plugin_id !== core.plugin_id),
    releases,
    latestVersion: latestCoreRelease(releases)?.version ?? null,
    reports: site.compatibility.filter((entry) => entry.emulator === core.plugin_id).length,
  };
});
---

<ProductLayout locale={locale} title={t.title} description={t.description} current="cores">
  <div class="container page-head">
    <p class="breadcrumb"><a href={`${base}/shinkiemu/`}>ShinkiEMU</a></p>
    <h1>{t.title}</h1>
    <p class="lead">{t.lead}</p>
    <p class="note">{t.supportedNote}</p>
    <StateLegend locale={locale} />
    <nav aria-label={t.jump}>
      <ul class="jump-list">
        {
          cores.map((core) => (
            <li>
              <a href={`#${core.anchor}`}>{core.core}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container core-list">
    {
      cores.map((core) => (
        <section class="card core-card" id={core.anchor} aria-labelledby={`${core.anchor}-title`}>
          <div class="core-card-head">
            <h2 id={`${core.anchor}-title`}>{core.core}</h2>
            {core.reports === 0 ? (
              <span class="muted">{t.compatibility(0)}</span>
            ) : (
              <a href={`${base}/shinkiemu/compatibility/?core=${encodeURIComponent(core.plugin_id)}`}>
                {t.compatibility(core.reports)}
              </a>
            )}
          </div>

          <dl class="facts">
            <div>
              <dt>{t.family}</dt>
              <dd>{core.family}</dd>
            </div>
            <div>
              <dt>{t.pluginId}</dt>
              <dd>
                <code>{core.plugin_id}</code>
              </dd>
            </div>
            <div>
              <dt>{t.license}</dt>
              <dd>{core.license}</dd>
            </div>
            <div>
              <dt>{t.coreVersion}</dt>
              <dd>
                <code class="core-version">{core.version}</code>
              </dd>
            </div>
            <div>
              <dt>{t.revision}</dt>
              <dd>
                <a href={`${core.repo}/tree/${core.revision}`} aria-label={t.revisionLabel(core.shortRevision, core.repoName)}>
                  <code class="hash hash-short">{core.shortRevision}</code>
                </a>
              </dd>
            </div>
            <div>
              <dt>{t.sourceRepo}</dt>
              <dd>
                <a href={core.repo}>{core.repoName}</a>
                {core.adapter_branch && (
                  <>
                    <span class="muted"> · </span>
                    <a
                      href={`${core.repo}/tree/${core.adapter_branch}`}
                      aria-label={t.adapterBranchLabel(core.adapter_branch, core.repoName)}
                    >
                      <code>{core.adapter_branch}</code>
                    </a>
                  </>
                )}
              </dd>
            </div>
            <div>
              <dt>{t.upstream}</dt>
              <dd>
                {core.upstream ? (
                  <a href={core.upstream} aria-label={t.upstreamLabel(core.core)}>
                    {core.upstreamName}
                  </a>
                ) : (
                  <span class="muted">{t.owned}</span>
                )}
              </dd>
            </div>
            {core.identity && (
              <div>
                <dt>{t.upstreamRef}</dt>
                <dd>
                  <span class="chip chip-static">
                    {core.identity.upstream.ref_kind === 'tag' ? t.tagRef : t.branchRef}
                  </span>{' '}
                  <a
                    href={`${core.identity.upstream.repo}/tree/${core.identity.upstream.commit}`}
                    aria-label={t.upstreamRefLabel(
                      core.identity.upstream.ref_name,
                      core.upstreamCommitShort ?? '',
                      core.upstreamIdentityName ?? '',
                    )}
                  >
                    <code class="ref-name">{core.identity.upstream.ref_name}</code>
                    <span class="muted">@</span>
                    <code class="hash hash-short">{core.upstreamCommitShort}</code>
                  </a>
                </dd>
              </div>
            )}
          </dl>

          <PlatformStates states={core.states} locale={locale} label={`${core.core} · ${t.targets}`} />

          {(core.publish_blocked || core.static_manager_targets.length > 0 || core.siblings.length > 0) && (
            <ul class="core-notes">
              {core.publish_blocked && (
                <li>
                  <span class="chip chip-blocked">{t.publishBlocked}</span>
                  {core.publish_blocked}
                </li>
              )}
              {core.static_manager_targets.length > 0 && (
                <li>
                  <span class="chip chip-static">{t.staticBadge}</span>
                  {t.staticInManager(core.static_manager_targets.join(', '))}
                </li>
              )}
              {core.siblings.length > 0 && <li>{t.sameFamily(core.siblings.map((other) => other.core).join(', '))}</li>}
            </ul>
          )}

          <details class="target-details">
            <summary>{t.targetsSummary(core.supported, core.targets.length)}</summary>
            <div class="table-scroll" tabindex="0" role="region" aria-label={`${core.core} · ${t.targets}`}>
              <table class="data-table">
                <thead>
                  <tr>
                    <th scope="col">{t.target}</th>
                    <th scope="col">{t.targetStatus}</th>
                    <th scope="col">{t.reason}</th>
                  </tr>
                </thead>
                <tbody>
                  {core.targets.map((target) => (
                    <tr>
                      <th scope="row">
                        <code>{target.target}</code>
                      </th>
                      <td>
                        <span class={`chip chip-${target.status === 'blocked' ? 'blocked' : 'supported'}`}>
                          {target.status === 'blocked' ? t.blocked : t.supported}
                        </span>
                        {target.status === 'static' && <span class="chip chip-static">{t.staticBadge}</span>}
                      </td>
                      <td>{target.reason}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>

          <h3>{t.releases}</h3>
          {core.releases.length === 0 ? (
            <p class="muted">{t.noReleases}</p>
          ) : (
            <div class="table-scroll" tabindex="0" role="region" aria-label={`${core.core} · ${t.releases}`}>
              <table class="data-table">
                <thead>
                  <tr>
                    <th scope="col">{t.version}</th>
                    <th scope="col">{t.releasePlatform}</th>
                    <th scope="col">{t.tag}</th>
                    <th scope="col">{t.size}</th>
                    <th scope="col">{t.sha256}</th>
                    <th scope="col">{t.download}</th>
                  </tr>
                </thead>
                <tbody>
                  {core.releases.map((release) => (
                    <tr>
                      <th scope="row" class="release-version">
                        {release.identity ? (
                          <span class="release-source">
                            <a
                              href={`${release.identity.upstream.repo}/tree/${release.identity.upstream.commit}`}
                              aria-label={t.upstreamRefLabel(
                                release.identity.upstream.ref_name,
                                release.identity.upstream.commit.slice(0, 12),
                                release.identity.upstream.repo.replace('https://github.com/', ''),
                              )}
                            >
                              <code class="ref-name">{release.identity.upstream.ref_name}</code>
                              <span class="muted">@</span>
                              <code class="hash hash-short">{release.identity.upstream.commit.slice(0, 12)}</code>
                            </a>
                            <span class="muted"> (adapter </span>
                            <a
                              href={`${release.identity.adapter.repo}/tree/${release.identity.adapter.commit}`}
                              aria-label={t.revisionLabel(
                                release.identity.adapter.commit.slice(0, 12),
                                release.identity.adapter.repo.replace('https://github.com/', ''),
                              )}
                            >
                              <code class="hash hash-short">{release.identity.adapter.commit.slice(0, 12)}</code>
                            </a>
                            <span class="muted">)</span>
                          </span>
                        ) : (
                          <code>{release.version}</code>
                        )}
                        {core.latestVersion === release.version && (
                          <span class="chip chip-supported">{t.latest}</span>
                        )}
                      </th>
                      <td class="nowrap">
                        <code>{release.platform}</code>
                      </td>
                      <td class="release-tag">
                        <code>{release.release_tag}</code>
                      </td>
                      <td class="nowrap">{formatBytes(release.size, locale)}</td>
                      <td>
                        <code class="hash">{release.sha256}</code>
                      </td>
                      <td>
                        <a
                          class="button button-primary"
                          href={release.url}
                          aria-label={t.downloadLabel(
                            release.display_name,
                            release.platform,
                            coreReleaseLabel(release),
                          )}
                        >
                          {t.download}
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      ))
    }
  </div>
</ProductLayout>
