---
import DownloadButton from '../../../components/DownloadButton.astro';
import DownloadCards from '../../../components/DownloadCards.astro';
import EngineGrid from '../../../components/EngineGrid.astro';
import PageHero from '../../../components/PageHero.astro';
import ResourceLinks from '../../../components/ResourceLinks.astro';
import ShinkiFacts from '../../../components/ShinkiFacts.astro';
import ProductLayout from '../../../layouts/ProductLayout.astro';
import { LOCALES, STRINGS, type Locale } from '../../../lib/i18n.ts';
import { engineFamilies } from '../../../lib/platforms.ts';
import { site } from '../../../lib/site.ts';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const strings = STRINGS[locale];
const t = strings.shinkiemu;
const base = `/${locale}`;
const families = engineFamilies(site.matrix, site.targets).length;
---

<ProductLayout locale={locale} title={t.title} description={t.description} current="shinkiemu">
  <PageHero eyebrow={t.eyebrow} title="ShinkiEMU" pitch={t.pitch} lead={t.lead}>
    <DownloadButton locale={locale} href="#download" />
    <a class="button button-secondary" href="#download">{strings.download.allPlatforms}</a>
    <a class="button button-ghost" href={`${base}/shinkiemu/compatibility/`}>{t.compatibility}</a>
  </PageHero>

  <section class="section container" aria-labelledby="facts-title">
    <div class="section-head">
      <h2 id="facts-title">{strings.facts.title}</h2>
    </div>
    <ShinkiFacts locale={locale} />
  </section>

  <section class="section container" aria-labelledby="steps-title">
    <div class="section-head">
      <h2 id="steps-title">{t.stepsTitle}</h2>
    </div>
    <ol class="grid grid-3 step-list">
      {
        t.steps.map((step, i) => (
          <li class="card feature-card">
            <h3>
              <span class="feature-index" aria-hidden="true">
                {i + 1}
              </span>
              {step.title}
            </h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="section-foot">
      <a href={`${base}/shinkiemu/docs/user-guide/`}>{t.guide}</a>
    </p>
  </section>

  <section class="section container" aria-labelledby="engines-title">
    <div class="section-head">
      <h2 id="engines-title">{strings.engines.title}</h2>
      <p><strong>{strings.engines.summary(families, site.matrix.length)}</strong></p>
      <p>{strings.engines.lead}</p>
    </div>
    <EngineGrid locale={locale} />
    <p class="section-foot">
      <a class="button button-secondary" href={`${base}/shinkiemu/cores/`}>{strings.engines.allCores}</a>
    </p>
  </section>

  <section class="section container" id="download" aria-labelledby="download-title" tabindex="-1">
    <div class="section-head">
      <h2 id="download-title">{t.downloadTitle}</h2>
      <p>{t.downloadLead}</p>
    </div>
    <DownloadCards locale={locale} />
  </section>

  <section class="section container" aria-labelledby="resources-title">
    <div class="section-head">
      <h2 id="resources-title">{strings.resources.title}</h2>
    </div>
    <ResourceLinks locale={locale} product="shinkiemu" />
  </section>
</ProductLayout>
