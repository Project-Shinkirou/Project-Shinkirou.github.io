---
import DownloadButton from '../../components/DownloadButton.astro';
import DownloadCards from '../../components/DownloadCards.astro';
import EngineGrid from '../../components/EngineGrid.astro';
import PageHero from '../../components/PageHero.astro';
import ResourceLinks from '../../components/ResourceLinks.astro';
import ShinkiFacts from '../../components/ShinkiFacts.astro';
import ProductLayout from '../../layouts/ProductLayout.astro';
import { LOCALES, STRINGS, type Locale } from '../../lib/i18n.ts';
import { engineFamilies } from '../../lib/platforms.ts';
import { site } from '../../lib/site.ts';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const strings = STRINGS[locale];
const t = strings.home;
const base = `/${locale}`;
const families = engineFamilies(site.matrix, site.targets).length;
---

<ProductLayout locale={locale} title={t.title} description={t.description} current="home">
  <PageHero size="home" eyebrow={t.eyebrow} title="Project-Shinkirou" pitch={t.tagline} lead={t.intro}>
    <DownloadButton locale={locale} href="#download" />
    <a class="button button-secondary" href={`${base}/shinkiemu/#download`}>{strings.download.allPlatforms}</a>
    <a class="button button-ghost" href={`${base}/roukaku/`}>RoukakuEngine</a>
  </PageHero>

  <section class="section container" aria-labelledby="products-title">
    <h2 id="products-title" class="sr-only">{t.productsTitle}</h2>
    <div class="grid grid-2">
      <article class="card product-card tone-cyan" aria-labelledby="product-shinkiemu">
        <p class="product-kicker">{t.shinkiemu.kicker}</p>
        <h3 id="product-shinkiemu">ShinkiEMU</h3>
        <p class="product-body">{t.shinkiemu.body}</p>
        <div class="actions">
          <a class="button button-primary" href={`${base}/shinkiemu/`}>{t.shinkiemu.cta}</a>
        </div>
      </article>
      <article class="card product-card tone-gold" aria-labelledby="product-roukaku">
        <p class="product-kicker">{t.roukaku.kicker}</p>
        <h3 id="product-roukaku">RoukakuEngine</h3>
        <p class="product-body">{t.roukaku.body}</p>
        <div class="actions">
          <a class="button button-gold" href={`${base}/roukaku/`}>{t.roukaku.cta}</a>
        </div>
      </article>
    </div>
  </section>

  <section class="section container" aria-labelledby="facts-title">
    <div class="section-head">
      <h2 id="facts-title">{strings.facts.title}</h2>
    </div>
    <ShinkiFacts locale={locale} />
  </section>

  <section class="section container" aria-labelledby="engines-title">
    <div class="section-head">
      <h2 id="engines-title">{strings.engines.title}</h2>
      <p><strong>{strings.engines.summary(families, site.matrix.length)}</strong></p>
      <p>{strings.engines.lead}</p>
    </div>
    <EngineGrid locale={locale} />
    <p class="section-foot">
      <a class="button button-secondary" href={`${base}/shinkiemu/cores/`}>{strings.engines.allCores}</a>
    </p>
  </section>

  <section class="section container" id="download" aria-labelledby="download-title" tabindex="-1">
    <div class="section-head">
      <h2 id="download-title">{t.downloadTitle}</h2>
      <p>{t.downloadLead}</p>
    </div>
    <DownloadCards locale={locale} compact />
    <p class="section-foot">
      <a class="button button-secondary" href={`${base}/shinkiemu/#download`}>{strings.download.details}</a>
    </p>
  </section>

  <section class="section container" aria-labelledby="resources-title">
    <div class="section-head">
      <h2 id="resources-title">{strings.resources.title}</h2>
    </div>
    <ResourceLinks locale={locale} />
  </section>
</ProductLayout>
