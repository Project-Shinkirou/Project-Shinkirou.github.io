---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

// GitHub Pages serves this single /404.html for every unknown URL in both
// languages, so it replaces Starlight's default-locale-only 404 route
// (`disable404Route` in astro.config.ts).
---

<StarlightPage
  frontmatter={{
    title: '404',
    description: '页面不存在 / Page not found',
    template: 'splash',
    tableOfContents: false,
    pagefind: false,
    editUrl: false,
  }}
  hasSidebar={false}
>
  <p class="portal-lead" lang="zh-CN">页面不存在。</p>
  <p class="portal-lead" lang="en">Page not found.</p>
  <ul class="product-links">
    <li><a class="portal-button" href="/zh-cn/" lang="zh-CN">返回中文首页</a></li>
    <li><a href="/en/" lang="en">English home</a></li>
  </ul>
</StarlightPage>
